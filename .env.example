# Copy to .env and fill in. Never commit .env.

# --- required for docker compose ---
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
MINIO_ROOT_PASSWORD=change-me-min-8-chars
GRAFANA_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

# --- database (docker compose builds the URL itself; this is for running Django locally) ---
POSTGRES_USER=finsight
POSTGRES_DB=finsight
# DATABASE_URL=postgres://finsight:change-me@localhost:5432/finsight   (unset = SQLite for local dev)

# --- SEC EDGAR: required by the SEC (a real name and email), used for every request ---
SEC_USER_AGENT="Your Name you@example.com"

# --- LLM: set ONE (provider "auto" picks the first available), or run Ollama locally ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- pipeline ---
FINSIGHT_CONFIG=ml/configs/dense_rerank_ctx.yaml
SERVING_URL=http://localhost:8001
# Shared secret for serving's admin endpoints (/v1/admin/reload). Empty = unprotected (private network only).
SERVING_ADMIN_TOKEN=

# --- Django ---
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_LLM=30/min
THROTTLE_INGEST=10/hour
# Ingestion is heavy: in production only staff/admins may trigger it (default on in prod). Set ALLOW_REGISTRATION=false
# to close public sign-ups once your accounts exist.
INGEST_STAFF_ONLY=true
ALLOW_REGISTRATION=true

# --- optional: Langfuse tracing (create keys in the Langfuse UI at :3002) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
